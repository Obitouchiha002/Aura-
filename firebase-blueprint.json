{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "dailyMessageCount": { "type": "number", "description": "Number of messages sent today" },
        "lastMessageDate": { "type": "string", "description": "Date string of the last message sent (YYYY-MM-DD)" }
      },
      "required": ["uid", "email", "role", "createdAt", "lastLoginAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A chat session for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "mode": { "type": "string" },
        "character": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "uid", "title", "mode", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message within a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "text": { "type": "string" },
        "isAi": { "type": "boolean" },
        "character": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "sessionId", "uid", "text", "isAi", "timestamp"]
    },
    "Session": {
      "title": "Session",
      "description": "A user session tracking activity",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "durationSeconds": { "type": "number" }
      },
      "required": ["sessionId", "uid", "email", "startTime"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Global application settings configurable by admin",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "welcomeMessage": { "type": "string" }
      },
      "required": ["maintenanceMode"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and roles"
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Stores chat sessions for a user"
    },
    "/users/{userId}/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Stores messages within a chat session"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Stores user activity sessions"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Stores global app settings"
    }
  }
}
