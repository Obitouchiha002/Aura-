node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.vercel

# Capacitor build output — regenerate with: npx cap sync android
android/app/build/
android/.gradle/
android/build/
android/local.properties

# Android signing key — never commit. Losing it means you can never update the app.
android/keystore/
*.jks
*.keystore
!~/.android/debug.keystore
android/keystore.properties

# Live-update bundles — regenerate with scripts/release-bundle.mjs
landing/download/updates/*.zip
# The live-update bundle ships with the app's deployment, so it is tracked.
!public/updates/*.zip

# The APK ships with the app's deployment so it can be published by a push.
!public/download/*.apk
