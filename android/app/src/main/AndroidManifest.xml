<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- windowSoftInputMode is adjustNothing, not adjustResize.

             Two things were resizing the webview for the keyboard: Android,
             because of adjustResize, and Capacitor's SystemBars, which applies
             the IME inset itself. On a device running both, a 349px keyboard
             took the viewport from 776 to 125 — subtracted twice — and the chat
             collapsed to a strip with the composer stranded at the top.

             Android resizes nothing now, and the web layer takes the space away
             once, using the height the keyboard plugin reports. See
             utils/keyboardInset.ts, which also detects the case where something
             else already resized and then stays out of the way. -->
        <activity
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app hand a downloaded build to Android's package installer, so
         updating does not mean opening the site in a browser and finding the
         file by hand. Android still shows its own install confirmation; no app
         can install another app silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
